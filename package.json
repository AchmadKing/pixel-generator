{
  "name": "pixel-game-asset-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local 2D pixel art game asset generator: prompt -> non-destructive post-processing -> live preview -> revision -> engine export.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "doctor": "node studio/cli/studio.js doctor",
    "scan": "node studio/cli/studio.js scan",
    "dev": "node studio/cli/studio.js dev",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:manual:fal": "node scripts/manual-fal-harness.js"
  },
  "keywords": [
    "pixel-art",
    "game-dev",
    "asset-generator",
    "godot",
    "unity"
  ],
  "author": "",
  "license": "MIT"
}
